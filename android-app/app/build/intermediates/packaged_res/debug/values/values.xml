<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="accent_cyan">#00D4FF</color>
    <color name="accent_cyan_dim">#1A3D4A</color>
    <color name="accent_purple">#7C4DFF</color>
    <color name="accent_purple_dim">#2A1F4A</color>
    <color name="bg_card">#1E2035</color>
    <color name="bg_input">#252640</color>
    <color name="bg_primary">#0F1019</color>
    <color name="bg_surface">#1A1B2E</color>
    <color name="black">#FF000000</color>
    <color name="border">#303450</color>
    <color name="divider">#2A2D45</color>
    <color name="ic_launcher_background">#1A1B2E</color>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="status_connected">#00E676</color>
    <color name="status_connected_dim">#0D3320</color>
    <color name="status_connecting">#FFD740</color>
    <color name="status_connecting_dim">#3D3010</color>
    <color name="status_disconnected">#FF5252</color>
    <color name="status_disconnected_dim">#3D1515</color>
    <color name="status_recording">#FF3D00</color>
    <color name="status_recording_dim">#3D1000</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="text_hint">#555A7A</color>
    <color name="text_primary">#EAEAF5</color>
    <color name="text_secondary">#8890BB</color>
    <color name="text_terminal">#00E5CC</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">RDM Client</string>
    <style name="ButtonStyle" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="ButtonStyle.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/accent_cyan</item>
        <item name="android:textColor">@color/accent_cyan</item>
        <item name="rippleColor">@color/accent_cyan_dim</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="ButtonStyle.Primary">
        <item name="backgroundTint">@color/accent_cyan</item>
        <item name="android:textColor">@color/bg_primary</item>
        <item name="rippleColor">@color/accent_cyan_dim</item>
    </style>
    <style name="ButtonStyle.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/accent_purple_dim</item>
        <item name="android:textColor">@color/accent_purple</item>
        <item name="rippleColor">@color/accent_purple</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="CardStyle.RdmClient" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="InputStyle.RdmClient" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/bg_input</item>
        <item name="boxStrokeColor">@color/border</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>
    <style name="TextStyle" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="TextStyle.SectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TextStyle.Terminal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_terminal</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:typeface">monospace</item>
    </style>
    <style name="Theme.RdmClient" parent="Theme.Material3.Dark">
        
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/accent_cyan_dim</item>
        <item name="colorOnPrimary">@color/bg_primary</item>
        
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorSecondaryVariant">@color/accent_purple_dim</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar" ns1:targetApi="m">false</item>
        
        <item name="materialCardViewStyle">@style/CardStyle.RdmClient</item>
        
        <item name="textInputStyle">@style/InputStyle.RdmClient</item>
    </style>
</resources>