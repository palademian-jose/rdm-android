<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Text Styles -->
    <style name="TextStyle" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="TextStyle.SectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextStyle.Terminal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_terminal</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:typeface">monospace</item>
    </style>

    <!-- Button Styles -->
    <style name="ButtonStyle" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="ButtonStyle.Primary">
        <item name="backgroundTint">@color/accent_cyan</item>
        <item name="android:textColor">@color/bg_primary</item>
        <item name="rippleColor">@color/accent_cyan_dim</item>
    </style>

    <style name="ButtonStyle.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/accent_cyan</item>
        <item name="android:textColor">@color/accent_cyan</item>
        <item name="rippleColor">@color/accent_cyan_dim</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="ButtonStyle.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/accent_purple_dim</item>
        <item name="android:textColor">@color/accent_purple</item>
        <item name="rippleColor">@color/accent_purple</item>
        <item name="cornerRadius">14dp</item>
    </style>

</resources>
