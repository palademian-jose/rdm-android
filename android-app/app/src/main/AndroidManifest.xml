    <!-- Root access (not declared in manifest, handled programmatically) -->

    <!-- Package visibility for Android 11+ -->
    <queries>
        <!-- Telegram variants -->
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="plus.messenger.android" />
