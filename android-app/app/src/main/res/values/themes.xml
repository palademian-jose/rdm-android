<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Main dark theme -->
    <style name="Theme.RdmClient" parent="Theme.Material3.Dark">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/accent_cyan_dim</item>
        <item name="colorOnPrimary">@color/bg_primary</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorSecondaryVariant">@color/accent_purple_dim</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <!-- Background -->
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <!-- Status bar and nav bar -->
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <!-- MaterialCardView defaults -->
        <item name="materialCardViewStyle">@style/CardStyle.RdmClient</item>
        <!-- TextInputLayout defaults -->
        <item name="textInputStyle">@style/InputStyle.RdmClient</item>
    </style>

    <!-- Card style -->
    <style name="CardStyle.RdmClient" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Input style -->
    <style name="InputStyle.RdmClient" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/bg_input</item>
        <item name="boxStrokeColor">@color/border</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <!-- Section header -->
    <style name="TextStyle.SectionHeader" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Terminal text -->
    <style name="TextStyle.Terminal" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_terminal</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <!-- Primary button -->
    <style name="ButtonStyle.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_cyan</item>
        <item name="android:textColor">@color/bg_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Outlined button (Disconnect) -->
    <style name="ButtonStyle.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/status_disconnected</item>
        <item name="android:textColor">@color/status_disconnected</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Tonal button (Test) -->
    <style name="ButtonStyle.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/accent_purple_dim</item>
        <item name="android:textColor">@color/accent_purple</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

</resources>
